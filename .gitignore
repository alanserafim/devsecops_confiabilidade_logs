# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Arquivos e diretórios específicos do sistema operacional
.DS_Store
Thumbs.db

# Arquivos de log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diretórios de dependências
# A instalação de dependências deve ser feita dentro do contêiner Docker
node_modules/
jspm_packages/
bower_components/
vendor/

# Arquivos de ambiente
# Nunca versione arquivos de ambiente, pois eles podem conter informações sensíveis.
# Em vez disso, versione um arquivo de exemplo.
.env
.env.local
.env.*.local
! .env.example

# Artefatos de build e diretórios de saída
dist/
build/
out/
target/

# Arquivos de configuração de IDEs
.idea/
.vscode/
*.swp
*.swo

# Arquivos de cache e temporários
.cache/
.tmp/

# Arquivos específicos do Docker que não devem ser versionados em alguns casos
# O Dockerfile e o docker-compose.yml geralmente são versionados,
# mas se contiverem informações sensíveis, considere adicioná-los.
# Dockerfile
# docker-compose.yml

# Relatórios de teste e cobertura de código
coverage/
.nyc_output/

# Dados de serviços (Bancos de Dados, etc.)
# Diretórios usados como volumes para persistir dados de serviços
# não devem ser versionados.
postgres-data/
pgdata/
data/
mysql-data/
db-data/

